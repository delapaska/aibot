# Скопируй в .env и заполни: cp .env.example .env
# .env не коммитится — секреты живут только здесь и в окружении контейнера.

# --- Postgres (совпадает с docker-compose.yml) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=aibot
POSTGRES_PASSWORD=aibot
POSTGRES_DB=aibot

# --- HTTP ---
HTTP_ADDR=:8080

# --- Telegram ---
# Токен из @BotFather. Пустое значение = бот выключен, работает только веб-панель.
TELEGRAM_TOKEN=

# --- LLM (OpenAI-совместимый API) ---
# base URL без завершающего слэша, ключ, название модели.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Резервные модели через запятую: если основная недоступна (например,
# исчерпан дневной лимит бесплатной модели), запрос уходит по цепочке.
LLM_FALLBACK_MODELS=

# --- Ограничения (необязательно) ---
# Через запятую: доступ к боту только этим Telegram ID. Пусто = разрешены все.
ALLOWED_TELEGRAM_IDS=
# Необязательный Bearer-токен для API панели. Пусто = без авторизации (по ТЗ).
PANEL_TOKEN=

# --- Прочее ---
# Часовой пояс семьи: «вчера» и «в этом месяце» считаются относительно него.
APP_TZ=Europe/Moscow
LOG_LEVEL=info
